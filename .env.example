# Required on Vercel so reported questions persist in the repo JSON file.
# Create a fine-grained GitHub PAT with Contents: Read and Write on this repo.
REPORTED_QUESTIONS_GITHUB_TOKEN=
REPORTED_QUESTIONS_GITHUB_REPO=mmontazami/AdSpace-sprint-nov
REPORTED_QUESTIONS_GITHUB_PATH=data/reported-questions.json
# Optional — defaults to the repository default branch
# REPORTED_QUESTIONS_GITHUB_BRANCH=main
